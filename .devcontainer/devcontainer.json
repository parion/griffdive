// Griffdive dev container: Nuxt 4 toolchain on the official Paseo image. Paseo is the
// remote client (daemon on :6767). Agent CLIs: opencode (v1, npm), opencode2 (v2, native,
// own state volume), claude (native). The native CLIs self-update in the home volume.
{
  "name": "griffdive",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteUser": "paseo",
  "updateRemoteUserUID": true,
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "mounts": [
    // Paseo home: daemon state, pairing and agent credentials survive rebuilds.
    "source=paseo-home-${devcontainerId},target=/home/paseo,type=volume",
    // Container-side deps outside the bind mount so host and container installs can't
    // clobber each other's binaries.
    "source=paseo-node-modules-${devcontainerId},target=/workspace/node_modules,type=volume",
    // Keeps pnpm's project-local store fallback off the bind mount.
    "source=paseo-pnpm-store-${devcontainerId},target=/workspace/.pnpm-store,type=volume",
    // Claude auth + settings; CLAUDE_CONFIG_DIR points ~/.claude and ~/.claude.json here.
    "source=claude-code-config-${devcontainerId},target=/home/paseo/.claude,type=volume",
    // OpenCode v2 config/sessions/cache/state; the launcher points XDG_* here so v2 never
    // shares directories with the v1 CLI. The v2 binary itself lives in ~/.opencode (home
    // volume) so it persists and self-updates.
    "source=opencode-v2-home-${devcontainerId},target=/home/paseo/.opencode2,type=volume"
  ],
  "forwardPorts": [
    3000,
    6767
  ],
  "portsAttributes": {
    "3000": {
      "label": "Nuxt dev",
      "onAutoForward": "openBrowser"
    },
    "6767": {
      "label": "Paseo web UI",
      "onAutoForward": "openBrowser"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "silent"
  },
  "containerEnv": {
    // Relay is opt-in in Paseo; force it on for every daemon launch from this container.
    "PASEO_RELAY_ENABLED": "true",
    "PASEO_LISTEN": "0.0.0.0:6767",
    // Keeps Claude's account/config in the volume above so sign-in survives rebuilds.
    "CLAUDE_CONFIG_DIR": "/home/paseo/.claude"
  },
  "remoteEnv": {
    // post-start.sh relocates npm's global prefix here so `npm -g` works unprivileged; keep
    // it ahead of /usr/local so those CLIs win. Non-VS Code shells get it via ~/.profile.
    "PATH": "/home/paseo/.npm-global/bin:${containerEnv:PATH}",
    // Optional: set PASEO_PASSWORD on the host to password-protect the daemon.
    "PASEO_PASSWORD": "${localEnv:PASEO_PASSWORD:}",
    // Context7 key for OpenCode v2's MCP (read as {env:CONTEXT7_API_KEY}). From the host so
    // the key is never committed; shells outside VS Code use ~/.opencode2/env instead.
    "CONTEXT7_API_KEY": "${localEnv:CONTEXT7_API_KEY:}"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "vitest.explorer",
        "ms-playwright.playwright"
      ]
    }
  }
}